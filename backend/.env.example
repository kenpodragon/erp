# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/erp_db
# Cloud SQL Unix Socket format
DATABASE_URL_LIVE=postgresql+psycopg2://user:password@/dbname?host=/cloudsql/project:region:instance
DB_INSTANCE_CONNECTION_NAME=project:region:instance

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Game Configuration
ENVIRONMENT=development
LOG_LEVEL=info
