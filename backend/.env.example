# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/erp_db
# Cloud SQL Unix Socket format
DATABASE_URL_LIVE=postgresql+psycopg2://user:password@/dbname?host=/cloudsql/project:region:instance
DB_INSTANCE_CONNECTION_NAME=project:region:instance

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
# Option A: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_JSON=secrets/firebase-service-account.json
# Option B: Inline JSON (preferred for Docker/Cloud Run — paste full JSON from Firebase Console)
# Generate at: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend URL (for Stripe redirect URLs)
FRONTEND_URL=http://localhost:5173

# Admin Access Control
# Comma-separated list of emails allowed to access /api/admin/ routes
ADMIN_ALLOWED_EMAILS=admin@example.com
# Comma-separated list of IPs allowed to access /api/admin/ routes (empty = allow all)
ADMIN_ALLOWED_IPS=

# Auth Bypass (testing only — NEVER enable in production)
# Double-gated: both this AND the DB toggle (ops.auth_bypass_enabled) must be true.
ALLOW_AUTH_BYPASS=false

# Game Configuration
ENVIRONMENT=development
LOG_LEVEL=info
