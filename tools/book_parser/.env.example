# Database (same as backend/.env)
DATABASE_URL=postgresql://user:password@localhost:5432/erp_db

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Optional: AI Model Configuration
# CLAUDE_MODEL Examples:
# - claude-haiku-4-5-20251001: (Recommended for Phase 1/2 Extraction) Fastest and most cost-efficient. Ideal for high-volume text splitting, structural parsing, and raw entity extraction where speed matters.
# - claude-sonnet-4-6:         (Recommended for Phase 3/4 Reasoning) Best balance of intelligence and cost. Excellent for entity resolution, cross-chapter consistency checks, and character/lore summarization.
# - claude-opus-4-6:           (Recommended for Phase 5 Generation) Most capable model. Use for final creative generation — character bios, enemy flavor text, and narrative-rich structured output requiring deep book comprehension.
# - claude-3-5-sonnet-20241022: (Legacy Stable) Previous-gen Sonnet. Reliable fallback if newer models behave unexpectedly.
CLAUDE_MODEL=claude-sonnet-4-6

# GEMINI_MODEL Examples:
# - gemini-2.0-flash: (Recommended for Phase 1/2 Extraction) Optimized for speed and cost. Great for high-volume text splitting and extracting raw data.
# - gemini-1.5-pro:   (Recommended for Phase 3/4 Reasoning) Best for complex entity resolution, cross-chapter consistency, and creative character generation.
# - gemini-1.5-flash: (Economy Fallback) Extremely fast, good for basic structural splitting if token limits are a concern.
# - gemini-3.0-flash: (If available) Latest generation with improved reasoning while maintaining high throughput.
GEMINI_MODEL=gemini-2.0-flash

# Optional: override books directory path (default: ../../../../Books)
# BOOKS_DIR=/path/to/Books
