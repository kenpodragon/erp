FROM postgres:17-alpine

# Copy init scripts — PostgreSQL runs these in alphabetical order on first start
COPY infra/deploy/db/init-user.sh /docker-entrypoint-initdb.d/01-init-user.sh
COPY infra/deploy/db/init-db.sh /docker-entrypoint-initdb.d/02-init-db.sh

# Copy SQL migration scripts (always available as fallback)
COPY db/001_init_db_tables.sql /sql/001_init_db_tables.sql
COPY db/002_system_seed_data.sql /sql/002_system_seed_data.sql
COPY db/003_sample_content_data.sql /sql/003_sample_content_data.sql

# Copy dump.sql if it exists (glob pattern avoids failure when missing)
COPY infra/deploy/db/dump.sq[l] /sql/

# Fix Windows line endings (CRLF -> LF) and make scripts executable
RUN sed -i 's/\r$//' /docker-entrypoint-initdb.d/01-init-user.sh \
    && sed -i 's/\r$//' /docker-entrypoint-initdb.d/02-init-db.sh \
    && sed -i 's/\r$//' /sql/001_init_db_tables.sql \
    && sed -i 's/\r$//' /sql/002_system_seed_data.sql \
    && sed -i 's/\r$//' /sql/003_sample_content_data.sql \
    && ([ -f /sql/dump.sql ] && sed -i 's/\r$//' /sql/dump.sql || true) \
    && chmod +x /docker-entrypoint-initdb.d/01-init-user.sh \
    && chmod +x /docker-entrypoint-initdb.d/02-init-db.sh

EXPOSE 5432
