# PostgreSQL Docker Container Credentials
# Copy this file to .env and fill in real values

# Root postgres superuser password
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Application user credentials (created by init-user.sh)
APP_USER=erp_app_user
APP_USER_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD
APP_DATABASE=erp_production
